{
  "name": "lablink",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "dev:demo": "firebase emulators:exec --only auth,firestore --project demo-lablink \"node scripts/dev-demo.mjs\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-lablink",
    "seed:pilot": "node --env-file=.env.local scripts/seed-pilot.mjs",
    "seed:emulator": "node scripts/seed-demo.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:performance": "lhci collect && lhci assert",
    "test:booking": "firebase emulators:exec --only auth,firestore --project demo-lablink \"node tests/integration/booking.mjs\"",
    "test:assistant": "node tests/integration/assistant.mjs",
    "test:auth": "firebase emulators:exec --only auth,firestore --project demo-lablink \"node tests/integration/auth.mjs\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "@fontsource-variable/public-sans": "^5.2.0",
    "@google/genai": "^3.6.1",
    "firebase": "^12.0.0",
    "firebase-admin": "^13.0.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "firebase-tools": "^15.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "postcss": "^8.5.0",
    "prettier": "^3.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx}": [
      "eslint --max-warnings=0",
      "prettier --write"
    ],
    "*.{css,json,md,yaml,yml}": "prettier --write"
  }
}
