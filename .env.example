# Firebase web app API key (public client configuration).
NEXT_PUBLIC_FIREBASE_API_KEY=
# Firebase web app authentication domain.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# Firebase web app project ID.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Firebase web app application ID.
NEXT_PUBLIC_FIREBASE_APP_ID=
# Firebase Admin service account project ID (server only).
FIREBASE_ADMIN_PROJECT_ID=
# Firebase Admin service account client email (server only).
FIREBASE_ADMIN_CLIENT_EMAIL=
# Firebase Admin private key with escaped newlines (server only).
FIREBASE_ADMIN_PRIVATE_KEY=
# Optional campus email domain for Google sign-in.
CAMPUS_EMAIL_DOMAIN=
# Canonical public origin if a reverse proxy changes the request URL.
LABLINK_APP_ORIGIN=
# Optional single-IP header overwritten by your trusted ingress. Empty uses a shared limit.
TRUSTED_CLIENT_IP_HEADER=
# The local demo launcher enables fixed emulator accounts automatically.
DEMO_LOGIN_ENABLED=false
# Firebase session cookie lifetime in days.
SESSION_COOKIE_DAYS=5
# Gemini API key from Google AI Studio (server only).
GEMINI_API_KEY=
# Gemini model ID for live requests.
GENAI_MODEL=
# Select mock for local development or gemini for live requests.
GENAI_PROVIDER=mock
# Enable AI assistance when a provider is configured.
AI_ENABLED=false
# Shared secret for scheduled jobs (server only).
CRON_SECRET=
